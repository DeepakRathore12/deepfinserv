{
  "name": "@dk/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env src/database/cli.ts migrate",
    "migrate:rollback": "tsx --env-file-if-exists=.env src/database/cli.ts rollback",
    "seed": "tsx --env-file-if-exists=.env src/database/cli.ts seed",
    "staff:create": "tsx --env-file-if-exists=.env src/database/create-staff.ts",
    "migrate:status": "tsx --env-file-if-exists=.env src/database/cli.ts status",
    "migrate:prod": "node --env-file-if-exists=.env dist/database/cli.js migrate",
    "seed:prod": "node --env-file-if-exists=.env dist/database/cli.js seed",
    "staff:create:prod": "node --env-file-if-exists=.env dist/database/create-staff.js"
  },
  "dependencies": {
    "@dk/shared": "workspace:*",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
