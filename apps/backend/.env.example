NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API from a browser (same origin through Nginx in production)
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://dk:dk@localhost:5432/dk_finance
DATABASE_SSL=false
# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production these come from AWS SSM Parameter Store (encrypted with KMS), never from a file in the repo.
DATA_ENCRYPTION_KEY=
HASH_PEPPER=
TOKEN_SECRET=
# OTP delivery: "console" logs codes (development only), "msg91" sends real SMS (needs DLT approval)
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Credit bureau: "none" books an advisor review; set a provider once a contract exists
BUREAU_PROVIDER=none
# Admin session cookie
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
LOG_LEVEL=info
OTP_ECHO=false
