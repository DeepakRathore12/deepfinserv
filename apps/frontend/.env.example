# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.deepfinserv.in
# Backend API base for browser calls (same origin through Nginx in production)
NEXT_PUBLIC_API_URL=/api/v1
# Backend API base for server-side rendering (private network address)
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
# Analytics (leave empty to disable)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# Search Console verification token
NEXT_PUBLIC_GSC_VERIFICATION=
# Set to "false" on staging to block indexing
NEXT_PUBLIC_ALLOW_INDEXING=true
