# Settings for the production Docker stack (docker-compose.prod.yml).
# On the server:  cp .env.example .env   then fill in every value marked REQUIRED.
# Never commit .env. It holds the keys that decrypt customer data.

# Makes plain `docker compose ...` use the production file.
COMPOSE_FILE=docker-compose.prod.yml

# ---------------------------------------------------------------- Site address
# DOMAIN: no https://. Needs DNS A records for DOMAIN and www.DOMAIN pointing at the server's Elastic IP.
DOMAIN=deepfinserv.in
# Email for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=
# The address visitors type, with scheme. Baked into the site at build time, so rebuild web if it changes.
SITE_URL=https://deepfinserv.in
# prod-https = real HTTPS (default). prod-http = plain HTTP for a test on the server's IP only.
NGINX_CONF=prod-https
# true when the site is served over HTTPS. Must be false for a prod-http test, or staff cannot sign in.
COOKIE_SECURE=true
# false = search engines are told not to index the site. Set true on the day you launch.
ALLOW_INDEXING=false

# ---------------------------------------------------------------- Secrets (REQUIRED)
# ---- Database: choose ONE of the two options.
# Option 1: AWS RDS (managed database, recommended). Create a database first, for example dk_finance.
#   The password must be letters and digits only (it goes into a URL).
#   DATABASE_SSL=true makes the API verify RDS's certificate (Amazon's CA bundle is built into the image).
#   The RDS security group must allow port 5432 from the EC2 instance's security group.
DATABASE_URL=postgres://USER:PASSWORD@YOUR-ENDPOINT.rds.amazonaws.com:5432/dk_finance
DATABASE_SSL=true
#
# Option 2: Postgres in Docker on this server. Replace the two lines above with these, and uncomment all three:
#   COMPOSE_PROFILES=localdb
#   DATABASE_URL=postgres://dk:SAME_AS_POSTGRES_PASSWORD@db:5432/dk_finance
#   DATABASE_SSL=false
# Password for the Docker database only (option 2). Letters and digits only.  Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Three different 32-byte keys, base64.  Generate each: openssl rand -base64 32
# DATA_ENCRYPTION_KEY encrypts mobile, PAN, name, DOB and email. LOSE IT AND THAT DATA IS GONE FOR GOOD.
# Keep a copy of all three somewhere safe that is not this server (a password manager).
DATA_ENCRYPTION_KEY=
HASH_PEPPER=
TOKEN_SECRET=

# ---------------------------------------------------------------- Mode
# PRODUCTION (use this for real customers). Needs a working SMS provider.
NODE_ENV=production
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# DEMO / TEST SERVER without SMS set up yet. Replace the four lines above with these.
# The one-time code is always 123456 and sample lenders are shown. NEVER use with real customers.
#   NODE_ENV=development
#   OTP_PROVIDER=console

LOG_LEVEL=info

# ---------------------------------------------------------------- Analytics (optional, baked in at build)
GTM_ID=
GA4_ID=
GSC_VERIFICATION=

# ---------------------------------------------------------------- Ports (change only for local testing)
HTTP_PORT=80
HTTPS_PORT=443
