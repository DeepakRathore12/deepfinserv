# Production Nginx inside Docker, with HTTPS from Let's Encrypt.
# The nginx image renders this file at start; ${DOMAIN} is the only variable it substitutes.
# Certificates are created by infra/scripts/init-ssl.sh and renewed by the certbot service.

limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=forms:10m rate=30r/m;

# Docker's built-in DNS. Resolving at request time means a restarted web or api container is picked up
# without reloading Nginx, and Nginx can start before they do.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 80;
  server_name ${DOMAIN} www.${DOMAIN};
  server_tokens off;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://${DOMAIN}$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name www.${DOMAIN};
  server_tokens off;
  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  return 301 https://${DOMAIN}$request_uri;
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${DOMAIN};
  server_tokens off;

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;

  client_max_body_size 128k;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;

  set $web http://web:3000;
  set $api http://api:4000;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;

  # Lender logo uploads are up to 200 KB; everything else keeps the small limit above.
  location ~ ^/api/v1/admin/lenders/[^/]+/logo$ {
    client_max_body_size 256k;
    proxy_pass $api;
  }
  # Writes that create records or send SMS get a tighter edge limit on top of the API's own limits.
  location ~ ^/api/v1/(otp|leads|applications|callbacks|partners|grievances|credit-score) {
    limit_req zone=forms burst=10 nodelay;
    proxy_pass $api;
  }
  location /api/ {
    limit_req zone=api burst=40 nodelay;
    proxy_pass $api;
  }
  location / {
    proxy_pass $web;
  }
}
