# Production Nginx inside Docker, plain HTTP only.
# For trying the stack on the server's IP address before a domain and certificate exist.
# Do not use this for real customers: mobile numbers, PAN and staff passwords would travel unencrypted.

limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=forms:10m rate=30r/m;

resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 80 default_server;
  server_name _;
  server_tokens off;

  client_max_body_size 128k;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  add_header X-Content-Type-Options nosniff always;

  set $web http://web:3000;
  set $api http://api:4000;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;

  location ~ ^/api/v1/admin/lenders/[^/]+/logo$ {
    client_max_body_size 256k;
    proxy_pass $api;
  }
  location ~ ^/api/v1/(otp|leads|applications|callbacks|partners|grievances|credit-score) {
    limit_req zone=forms burst=10 nodelay;
    proxy_pass $api;
  }
  location /api/ {
    limit_req zone=api burst=40 nodelay;
    proxy_pass $api;
  }
  location / {
    proxy_pass $web;
  }
}
